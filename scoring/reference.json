{
  "experiments": {
    "locomo_memory_retrieval": {
      "description": "Long-conversation memory retrieval on LoCoMo (the paper's benchmark): for each question, return at most 10 memory entries (dialogue turns) from that conversation's history. Scores how much of the labelled evidence is recovered and how much context is delivered, reflecting the paper's claim of preserved retrieval quality at a small per-query token footprint.",
      "notes": "Hidden test = 6 held-out LoCoMo conversations (955 questions, categories 1-4); visible train = 4 conversations (581 questions). Every retriever is run by the evaluator on label-free inputs and only its ranked entry IDs are read. The paper reports LLM-answer F1/BLEU-1/LLM-judge plus wall-clock latency and token consumption; it does not report evidence recall, so its numbers are not on this gym's scale and are kept under _paper_reported (unchanged). Wall-clock latency and self-reported operation counts are not scored (cannot be measured method-agnostically without timing). The single numeric entry under results.hippocampus is this gym's frozen reference run on the hidden test (seed 13), not a paper number. Runs that break the output contract or fall below 5% evidence recall are scored as failed (quality 0, maximal context).",
      "weight": 1.0,
      "primary_metric": "evidence_recall_at_10",
      "metrics": {
        "evidence_recall_at_10": {
          "higher_is_better": true,
          "coefficient": 1.0,
          "description": "Average fraction of a question's labelled evidence turns that appear among the (at most 10) returned entries, in percent."
        },
        "evidence_hit_at_1": {
          "higher_is_better": true,
          "coefficient": 0.4,
          "description": "Percent of questions whose top-ranked returned entry is a labelled evidence turn."
        },
        "answer_token_recall": {
          "higher_is_better": true,
          "coefficient": 0.4,
          "description": "Average fraction of the gold answer's content words present in the delivered context (timestamp + text of the returned entries, rebuilt by the evaluator), in percent."
        },
        "worst_category_recall": {
          "higher_is_better": true,
          "coefficient": 0.3,
          "description": "Lowest evidence recall@10 over the four LoCoMo question groups (single-hop, multi-hop, temporal, open-domain), in percent."
        },
        "avg_context_tokens": {
          "higher_is_better": false,
          "coefficient": -0.2,
          "description": "Average number of word tokens in the delivered context per question (per-query token footprint), recomputed by the evaluator from the returned entry IDs."
        }
      },
